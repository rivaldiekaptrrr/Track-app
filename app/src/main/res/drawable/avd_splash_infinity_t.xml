<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            
            <!-- Root Container Group (Perfect Center inside 108dp safe canvas) -->
            <group
                android:name="root_logo"
                android:scaleX="0.20"
                android:scaleY="0.20"
                android:translateX="28.4"
                android:translateY="27.2">
                
                <!-- Dual Stem Pillars Group (Slide down & reveal from top joint) -->
                <group
                    android:name="stems_group"
                    android:pivotX="128"
                    android:pivotY="124"
                    android:translateY="-24"
                    android:scaleY="0.1">
                    
                    <!-- Left Stem Rail -->
                    <path
                        android:name="stem_left"
                        android:fillAlpha="0.0"
                        android:pathData="M 104,124 L 118,124 L 118,214 L 104,228 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="111"
                                android:startY="124"
                                android:endX="111"
                                android:endY="228">
                                <item android:color="#06B6D4" android:offset="0.0" />
                                <item android:color="#2563EB" android:offset="0.6" />
                                <item android:color="#1D4ED8" android:offset="1.0" />
                            </gradient>
                        </aapt:attr>
                    </path>

                    <!-- Right Stem Rail -->
                    <path
                        android:name="stem_right"
                        android:fillAlpha="0.0"
                        android:pathData="M 126,124 L 140,124 L 140,196 C 140,206 136,216 126,226 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="133"
                                android:startY="124"
                                android:endX="133"
                                android:endY="226">
                                <item android:color="#00E5FF" android:offset="0.0" />
                                <item android:color="#06B6D4" android:offset="0.6" />
                                <item android:color="#2563EB" android:offset="1.0" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>

                <!-- Infinity Loops Group (Spring expansion from center) -->
                <group
                    android:name="loops_group"
                    android:pivotX="128"
                    android:pivotY="92"
                    android:scaleX="0.5"
                    android:scaleY="0.5">
                    
                    <!-- Left Loop -->
                    <path
                        android:name="loop_left"
                        android:fillAlpha="0.0"
                        android:fillType="evenOdd"
                        android:pathData="M 128,92 C 104,56 80,40 56,40 C 30,40 12,58 12,84 C 12,110 32,128 58,128 C 82,128 106,112 128,92 Z M 56,64 C 68,64 82,74 98,90 C 84,102 70,106 58,106 C 44,106 34,96 34,84 C 34,72 44,64 56,64 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="12"
                                android:startY="40"
                                android:endX="128"
                                android:endY="128">
                                <item android:color="#1E40AF" android:offset="0.0" />
                                <item android:color="#3B82F6" android:offset="0.5" />
                                <item android:color="#06B6D4" android:offset="1.0" />
                            </gradient>
                        </aapt:attr>
                    </path>

                    <!-- Right Loop -->
                    <path
                        android:name="loop_right"
                        android:fillAlpha="0.0"
                        android:fillType="evenOdd"
                        android:pathData="M 128,92 C 152,128 176,144 200,144 C 226,144 244,126 244,100 C 244,74 224,56 198,56 C 174,56 150,72 128,92 Z M 200,120 C 188,120 174,110 158,94 C 172,82 186,78 198,78 C 212,78 222,88 222,100 C 222,112 212,120 200,120 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="128"
                                android:startY="56"
                                android:endX="244"
                                android:endY="144">
                                <item android:color="#3B82F6" android:offset="0.0" />
                                <item android:color="#06B6D4" android:offset="0.5" />
                                <item android:color="#00E5FF" android:offset="1.0" />
                            </gradient>
                        </aapt:attr>
                    </path>

                    <!-- Front Twist Ribbon Bridge -->
                    <path
                        android:name="bridge"
                        android:fillAlpha="0.0"
                        android:pathData="M 98,90 C 112,104 124,114 136,120 L 148,108 C 138,100 126,88 114,76 L 98,90 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="98"
                                android:startY="76"
                                android:endX="148"
                                android:endY="120">
                                <item android:color="#3B82F6" android:offset="0.0" />
                                <item android:color="#06B6D4" android:offset="0.5" />
                                <item android:color="#00E5FF" android:offset="1.0" />
                            </gradient>
                        </aapt:attr>
                    </path>

                    <!-- Fold Shade for 3D Depth -->
                    <path
                        android:name="fold_shade"
                        android:fillAlpha="0.0"
                        android:pathData="M 114,76 L 128,92 L 136,82 L 122,66 Z">
                        <aapt:attr name="android:fillColor">
                            <gradient
                                android:type="linear"
                                android:startX="114"
                                android:startY="66"
                                android:endX="136"
                                android:endY="92">
                                <item android:color="#CC1E3A8A" android:offset="0.0" />
                                <item android:color="#002563EB" android:offset="1.0" />
                            </gradient>
                        </aapt:attr>
                    </path>
                </group>
            </group>
        </vector>
    </aapt:attr>

    <!-- 1. Loops Spring Scale & Fade In (0ms -> 550ms) -->
    <target android:name="loops_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="550"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="550"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="loop_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="loop_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="100"
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="bridge">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="220"
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="fold_shade">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="300"
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <!-- 2. Dual Stems Slide Down, Extend & Fade In (400ms -> 950ms) -->
    <target android:name="stems_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:startOffset="400"
                    android:duration="500"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="translateY"
                    android:valueFrom="-24"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:startOffset="400"
                    android:duration="500"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.1"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="stem_left">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="400"
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="stem_right">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:startOffset="480"
                android:duration="450"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:valueFrom="0.0"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

</animated-vector>
